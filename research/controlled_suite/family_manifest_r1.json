{
  "manifest_version": "1.0",
  "created_date": "2026-10-29",
  "status": "pilot_subset_revised_after_adversarial_oracle_audit_not_final",
  "purpose": "Machine-readable whole-family split manifest for the proposed deterministic Agent-policy evolution suite.",
  "split_rule": "All cases from a family stay in one split; no family variant may cross split boundaries.",
  "target_counts": {
    "total": 120,
    "train": 60,
    "validation": 30,
    "test": 30
  },
  "domains": [
    {
      "id": "D1",
      "name": "Filesystem and repository artifacts",
      "description": "Create/read/update/move/delete artifacts and verify state; entirely in-memory."
    },
    {
      "id": "D2",
      "name": "Calendar and resource scheduling",
      "description": "Inspect availability, create/cancel events, and detect conflicts; entirely simulated."
    },
    {
      "id": "D3",
      "name": "Inventory and order management",
      "description": "Lookup items, reserve/update quantities, and manage orders; entirely simulated."
    },
    {
      "id": "D4",
      "name": "Mock account ledger",
      "description": "Read balances, transfer funds, pay bills, and verify transactions in a synthetic ledger only."
    },
    {
      "id": "D5",
      "name": "Customer records and email",
      "description": "Resolve identity, read/update records, send and verify notifications in a mock database."
    }
  ],
  "families": [
    {
      "id": "F01",
      "split": "train",
      "name": "Read-before-write",
      "goal": "Resolve the correct target record before a mutation."
    },
    {
      "id": "F02",
      "split": "train",
      "name": "Sequential dependency",
      "goal": "Use an earlier tool result as a later tool argument."
    },
    {
      "id": "F03",
      "split": "train",
      "name": "Postcondition verification",
      "goal": "Read back and verify state after a mutation."
    },
    {
      "id": "F04",
      "split": "train",
      "name": "Numeric or threshold constraint",
      "goal": "Choose an action that satisfies an explicit numeric/threshold constraint."
    },
    {
      "id": "F05",
      "split": "train",
      "name": "Idempotency and duplicate prevention",
      "goal": "Avoid repeating a side effect when the request or action is duplicated."
    },
    {
      "id": "F06",
      "split": "train",
      "name": "Cross-tool handoff",
      "goal": "Coordinate two related tools/services while preserving consistent state."
    },
    {
      "id": "F07",
      "split": "validation",
      "name": "Ambiguous entity / safe no-op",
      "goal": "Detect multiple matches and avoid mutating an unresolved target; conversational clarification quality is not scored by the state-only oracle."
    },
    {
      "id": "F08",
      "split": "validation",
      "name": "Invalid precondition or policy conflict",
      "goal": "Detect an unmet precondition and refuse or safely no-op."
    },
    {
      "id": "F09",
      "split": "validation",
      "name": "Resource or availability conflict",
      "goal": "Detect a resource conflict and preserve valid state."
    },
    {
      "id": "F10",
      "split": "test",
      "name": "Cross-turn reference resolution",
      "goal": "Resolve a reference to an entity introduced earlier in the interaction."
    },
    {
      "id": "F11",
      "split": "test",
      "name": "Partial failure and compensation",
      "goal": "Recover safely after one step succeeds and a dependent step fails."
    },
    {
      "id": "F12",
      "split": "test",
      "name": "Minimal side-effect plan",
      "goal": "Achieve the goal while avoiding unrelated state changes."
    }
  ],
