{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yujian777555/openissue/research/controlled_suite/task_case_schema_r1.json",
  "title": "OpenIssue Controlled Agent Tool Task Case R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "family_id",
    "split",
    "domain_id",
    "variant_id",
    "difficulty",
    "tool_profile_id",
    "task",
    "initial_state",
    "oracle",
    "limits",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^F(0[1-9]|1[0-2])-D[1-5]-V[1-2]$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^F(0[1-9]|1[0-2])$"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "domain_id": {
      "type": "string",
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ]
    },
    "variant_id": {
      "enum": [
        "V1",
        "V2"
      ]
    },
    "difficulty": {
      "enum": [
        "standard",
        "hard"
      ]
    },
    "tool_profile_id": {
      "type": "string",
      "pattern": "^D[1-5]-TOOLS-R1$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_request"
      ],
      "properties": {
        "user_request": {
          "type": "string",
          "minLength": 8
        },
        "context": {
          "type": "string"
        },
        "family_contract_hidden": {
          "type": "string",
          "description": "Evaluator-only annotation; never include in the agent prompt."
        }
      }
    },
    "initial_state": {
      "type": "object"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_invariants",
        "forbidden_invariants"
      ],
      "properties": {
        "required_invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          },
          "minItems": 1
        },
        "forbidden_invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "forbidden_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_type"
            ],
            "properties": {
              "event_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "max_tool_calls"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "external_case_text_copied",
        "license_status"
      ],
      "properties": {
        "origin": {
          "const": "independently_authored"
        },
        "external_case_text_copied": {
          "const": false
        },
        "license_status": {
          "enum": [
            "internal_research_use",
            "owner_decision_pending_before_public_release"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_path",
        "operator"
      ],
      "properties": {
        "state_path": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "exists",
            "not_exists",
            "gte",
            "lte",
            "contains",
            "not_contains",
            "subset_of"
          ]
        },
        "expected": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}