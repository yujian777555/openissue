{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yujian777555/openissue/research/controlled_suite/task_case_schema_r1.json",
  "title": "OpenIssue Controlled Agent Tool Task Case R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "family_id",
    "split",
    "domain_id",
    "variant_id",
    "difficulty",
    "tool_profile_id",
    "task",
    "initial_state",
    "oracle",
    "limits",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^F(0[1-9]|1[0-2])-D[1-5]-V[1-2]$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^F(0[1-9]|1[0-2])$"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "domain_id": {
      "type": "string",
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ]
    },
    "variant_id": {
      "enum": [
        "V1",
        "V2"
      ]
    },
    "difficulty": {
      "enum": [
        "standard",
        "hard"
      ]
    },
    "tool_profile_id": {
      "type": "string",
      "pattern": "^D[1-5]-TOOLS-R1$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_request"
      ],
      "properties": {
        "user_request": {
          "type": "string",
          "minLength": 8
        },
        "context": {
          "type": "string"
        }
      }
    },
    "initial_state": {
      "type": "object"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_invariants",
        "forbidden_invariants"
      ],
      "properties": {
        "required_invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          },
          "minItems": 1
        },
        "forbidden_invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "forbidden_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_type"
            ],
            "properties": {
              "event_type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "max_tool_calls"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "external_case_text_copied",
        "license_status"
      ],
      "properties": {
        "origin": {
          "const": "independently_authored"
        },
        "external_case_text_copied": {
          "const": false
        },
        "license_status": {
          "enum": [
            "internal_research_use",
            "owner_decision_pending_before_public_release"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "trace_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordered_successful_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_successful_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_successful_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "min_successful_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "max_mutating_successes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "min_error_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "min_replayed_calls": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required_arg_match": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "producer_tool",
              "source",
              "source_pointer",
              "consumer_tool",
              "consumer_arg"
            ],
            "properties": {
              "producer_tool": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "args",
                  "result"
                ]
              },
              "source_pointer": {
                "type": "string",
                "pattern": "^(/.*)?$"
              },
              "consumer_tool": {
                "type": "string"
              },
              "consumer_arg": {
                "type": "string"
              }
            }
          }
        },
        "ordered_calls": {
          "type": "array",
          "description": "Ordered subsequence of required tool-call events. Each pattern checks the tool, status, optional schema_valid flag, and a partial set of arguments.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "status",
              "args"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "success",
                  "replayed",
                  "error",
                  "blocked"
                ]
              },
              "schema_valid": {
                "type": "boolean"
              },
              "args": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_path",
        "operator"
      ],
      "properties": {
        "state_path": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "exists",
            "not_exists",
            "gte",
            "lte",
            "contains",
            "not_contains",
            "subset_of"
          ],
          "description": "eq/ne use JSON type-sensitive equality; gte/lte are numeric-only and reject booleans; contains supports string substrings, array items, dictionary keys, or partial object matching against dictionary values; subset_of checks type-sensitive array membership or object key/value subsets."
        },
        "expected": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "description": "The evaluator and prompt builder must explicitly pass only task.user_request, permitted task.context, and the selected tool profile to the agent. Do not serialize evaluator-side initial_state, oracle, split, family metadata, trace_constraints, or provenance into the agent prompt. state_path and source_pointer use RFC 6901-style JSON Pointers. ordered_calls can pin the order and arguments of critical trace events without fixing implementation-generated IDs or idempotency keys. The evaluator must not expose reference actions to the Agent."
}
